{
  "appId": "com.nimoriq.nfachoices",
  "appName": "NFA Choices",
  "webDir": "dist/app",
  "backgroundColor": "#ffe9d6",
  "ios": {
    "contentInset": "never",
    "scrollEnabled": false,
    "backgroundColor": "#ffe9d6"
